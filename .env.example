# ===========================================================================
# Sentinel — Environment Configuration Template
# ===========================================================================
#
# USAGE:
#   cp .env.example .env
#   Edit .env with your values for local development
#   NEVER commit .env to version control
#
# This template documents every environment variable the application needs.
# Reference: docs/07-Backend-Development-Standards §11
#
# ===========================================================================


# ===========================================================================
# DATABASE
# ===========================================================================

# PostgreSQL async connection string (SQLAlchemy + asyncpg)
# Format: postgresql+asyncpg://user:password@host:port/dbname
# Used by: Application runtime (FastAPI endpoints)
# Role: sentinel_api (restricted privileges per 04-Database-Design §11.1)
# Required
DATABASE_URL=postgresql+asyncpg://sentinel_api:change_me_sentinel_api_password@localhost:5432/sentinel

# PostgreSQL connection string for migrations (synchronous driver)
# Format: postgresql://user:password@host:port/dbname
# IMPORTANT: Use synchronous postgresql:// driver, NOT postgresql+asyncpg://
# Alembic migrations require synchronous database access to properly manage
# transaction semantics and schema changes. The application uses asyncpg at
# runtime, but migrations execute with the sync psycopg2 driver.
# Used by: Alembic migrations (alembic upgrade head)
# Role: schema_owner (DDL/migration identity; never used by application)
# Required for migrations
DATABASE_MIGRATION_URL=postgresql://schema_owner:change_me_schema_owner_password@localhost:5432/sentinel

# PostgreSQL Role Provisioning (Phase 3)
# Per 04-Database-Design §11.1: Two-role architecture for privilege separation
#
# schema_owner: DDL/migration identity; owns all tables; used by Alembic only
#   Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
#   Required | Secret
POSTGRESQL_SCHEMA_OWNER_PASSWORD=change_me_schema_owner_password

# sentinel_api: Application runtime identity; restricted privileges per table
#   Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
#   Required | Secret
POSTGRESQL_SENTINEL_API_PASSWORD=change_me_sentinel_api_password


# ===========================================================================
# QUEUE / TASK BROKER
# ===========================================================================

# Redis connection URL for Celery broker and result backend
# Required
REDIS_URL=redis://localhost:6379/0


# ===========================================================================
# OBJECT STORAGE
# ===========================================================================

# S3-compatible endpoint URL (MinIO for local development)
# Required
S3_ENDPOINT_URL=http://localhost:9000

# S3 access key ID
# Required | Secret
S3_ACCESS_KEY=minioadmin

# S3 secret access key
# Required | Secret
S3_SECRET_KEY=minioadmin

# S3 bucket name for assets
# Required
S3_BUCKET_NAME=sentinel-assets


# ===========================================================================
# AUTHENTICATION & SECURITY
# ===========================================================================

# JWT signing secret key — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Required | Secret
JWT_SECRET_KEY=CHANGE-ME-generate-a-strong-random-secret-in-production

# JWT signing algorithm
# Valid values: HS256, RS256
# Optional — defaults to HS256
JWT_ALGORITHM=HS256

# Access token lifetime in minutes
# Optional — defaults to 15
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days
# Optional — defaults to 7
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7


# ===========================================================================
# CORS
# ===========================================================================

# Comma-separated list of allowed origins
# Required
CORS_ORIGINS=http://localhost:3000


# ===========================================================================
# LOGGING
# ===========================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Optional — defaults to INFO
LOG_LEVEL=INFO


# ===========================================================================
# APPLICATION ENVIRONMENT
# ===========================================================================

# Application environment: development, staging, production, test
# Optional — defaults to development
# NOTE: test environment is automatically set by pytest and skips middleware
# that requires external services (e.g., rate limiting/Redis)
ENVIRONMENT=development
