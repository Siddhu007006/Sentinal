# ===========================================================================
# Sentinel — Environment Configuration Template
# ===========================================================================
#
# USAGE:
#   cp .env.example .env
#   Edit .env with your values for local development
#   NEVER commit .env to version control
#
# This template documents every environment variable the application needs.
# Reference: docs/07-Backend-Development-Standards §11
#
# ===========================================================================


# ===========================================================================
# DATABASE
# ===========================================================================

# PostgreSQL async connection string (SQLAlchemy + asyncpg)
# Format: postgresql+asyncpg://user:password@host:port/dbname
# Required
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel

# PostgreSQL connection string for migrations (with DDL privileges)
# Format: postgresql+asyncpg://user:password@host:port/dbname
# Required for migrations
DATABASE_MIGRATION_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel


# ===========================================================================
# QUEUE / TASK BROKER
# ===========================================================================

# Redis connection URL for Celery broker and result backend
# Required
REDIS_URL=redis://localhost:6379/0


# ===========================================================================
# OBJECT STORAGE
# ===========================================================================

# S3-compatible endpoint URL (MinIO for local development)
# Required
S3_ENDPOINT_URL=http://localhost:9000

# S3 access key ID
# Required | Secret
S3_ACCESS_KEY=minioadmin

# S3 secret access key
# Required | Secret
S3_SECRET_KEY=minioadmin

# S3 bucket name for assets
# Required
S3_BUCKET_NAME=sentinel-assets


# ===========================================================================
# AUTHENTICATION & SECURITY
# ===========================================================================

# JWT signing secret key — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Required | Secret
JWT_SECRET_KEY=CHANGE-ME-generate-a-strong-random-secret-in-production

# JWT signing algorithm
# Valid values: HS256, RS256
# Optional — defaults to HS256
JWT_ALGORITHM=HS256

# Access token lifetime in minutes
# Optional — defaults to 15
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days
# Optional — defaults to 7
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7


# ===========================================================================
# CORS
# ===========================================================================

# Comma-separated list of allowed origins
# Required
CORS_ORIGINS=http://localhost:3000


# ===========================================================================
# LOGGING
# ===========================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Optional — defaults to INFO
LOG_LEVEL=INFO


# ===========================================================================
# APPLICATION ENVIRONMENT
# ===========================================================================

# Application environment: development, staging, production
# Optional — defaults to development
ENVIRONMENT=development
