  "keyDesignDecisions": {
    "d1": "Inherit from BaseModel (consistency, shared infrastructure)",
    "d2": "UUID PK + (normalized_value, asset_type) UNIQUE (technical vs. domain identity)",
    "d3": "Mapped[T] syntax (type safety, clarity)",
    "d4": "StrEnum + CHECK constraint (zero-downtime asset type additions)",
    "d5": "Composite UNIQUE on (normalized_value, asset_type) (per-user deduplication)",
    "d6": "Structural immutability enforcement (no UPDATE on core fields)",
    "d7": "6 indexes optimized for common queries (user asset history, type filtering, deduplication)",
    "d8": "Nullable columns: upload_id, display_label, metadata, deleted_at",
    "d9": "Autogenerate migration + manual review (audit trail + quality)",
