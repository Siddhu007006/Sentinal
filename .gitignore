# ===========================================================================
# Sentinel .gitignore
# ===========================================================================

# Python bytecode and packaging
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
dist/
build/
*.whl

# Virtual environments (.venv*/ also catches stray copies like .venv-1)
.venv*/
venv/
ENV/

# Local agent/tool session state
.zcode/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Node / frontend
node_modules/
dist/
build/
.next/

# Environment / secrets — NEVER commit secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Docker
docker-compose.override.yml

# Database
*.sqlite3
*.db

# UV lock file is committed (reproducible builds),
# but local UV caches are not.
.uv/

# Generated verification artifacts (evidence belongs in docs, not raw output)
/backend/test_*.txt
/backend/test_*.log
/backend/*_violations.txt
/backend/coverage.json
